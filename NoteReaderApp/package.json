{
  "name": "notereader",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/stack": "^7.12.1",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-haptics": "^58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "^58.0.3",
    "expo-speech": "^58.0.3",
    "expo-status-bar": "~58.0.4",
    "jpeg-js": "^0.4.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-vision-camera": "^4.6.4",
    "vision-camera-resize-plugin": "^3.2.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "qrcode": "^1.5.4",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --no-coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "resolveJsonModule": true,
            "esModuleInterop": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "\\.(png|jpg|jpeg|gif|svg|tflite)$": "<rootDir>/__mocks__/fileMock.js"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "private": true
}
